{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tedlasso-strava",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-14",
  "observability": { "enabled": true },
  "triggers": {
    "crons": ["0 */4 * * *"]
  },
  "kv_namespaces": [
    { "binding": "STORE", "id": "PLACEHOLDER_REPLACED_AT_DEPLOY" }
  ],
  "vars": {
    "TIMEZONE": "America/Los_Angeles",
    "PRIVACY_TRIM_M": "250",
    // "off" drops the street-map tiles under the route and leaves the bare
    // path. See the privacy section in README.md.
    "BASEMAP": "on",
    "REDIRECT_URI": "http://localhost:8787/auth/callback"
  }
}
